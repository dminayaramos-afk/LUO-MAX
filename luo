#!/usr/bin/env python3
import sys
import argparse
from core.engine import OptimizationEngine

def main():
    parser = argparse.ArgumentParser(description="Linux Universal Optimizer (LUO)")
    parser.add_argument("command", choices=["optimize", "restore", "status", "history"], help="Acción a realizar")
    parser.add_argument("--verbose", action="store_true", help="Modo detallado")
    parser.add_argument("--live", action="store_true", help="Salida dinámica en tiempo real")
    parser.add_argument("--quiet", action="store_true", help="Modo silencioso")
    parser.add_argument("--auto", action="store_true", help="Selección automática de perfiles seguros")
    parser.add_argument("--gaming", action="store_true", help="Incluir optimizaciones gaming")
    parser.add_argument("--persistence", action="store_true", help="Configurar persistencia mediante systemd")

    args = parser.parse_args()
    engine = OptimizationEngine(verbose=args.verbose, live=args.live, quiet=args.quiet)

    if args.command == "optimize":
        engine.optimize(auto=args.auto, gaming=args.gaming, persistence=args.persistence)
    elif args.command == "restore":
        engine.restore()
    elif args.command == "status":
        engine.status()
    elif args.command == "history":
        engine.history()

if __name__ == "__main__":
    main()
